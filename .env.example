# Sesión de Google en MyNotes Web (solo servidor; NUNCA uses el prefijo NEXT_PUBLIC_ para estos valores)
# Copia este archivo a .env.local para desarrollo local. No subas valores reales a git.

# Mismo client ID del cliente OAuth web que ya usa la app (no crees otro: drive.file es por cliente).
GOOGLE_CLIENT_ID=
# Client secret de ese mismo cliente OAuth web.
GOOGLE_CLIENT_SECRET=
# Cadena aleatoria de al menos 32 caracteres (p. ej. `openssl rand -base64 48`). Cifra las cookies.
SESSION_SECRET=
# Orígenes permitidos separados por comas, sin barra final.
# Ejemplo: https://mi-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

<?xml version="1.0" encoding="utf-8"?>
<!--
  IMPORTANT: Keep transparent in BOTH light and dark mode.
  DecoratedCustomViewStyle already provides the correct system surface color
  that adapts to light/dark and respects OEM themes (MIUI, Samsung, etc.).
  A hardcoded solid color here causes a visible tone mismatch with the system
  notification header ("MyNotes • 1m") which we do NOT control.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Checkbox "filled" state — solid green square with rounded corners, no checkmark icon.
  Matches the reference design where a completed habit shows a fully green-filled square.
  Used in RemoteViews via setImageViewResource() for habits that are completed today.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="5dp" />
    <solid android:color="#22C55E" />
</shape>

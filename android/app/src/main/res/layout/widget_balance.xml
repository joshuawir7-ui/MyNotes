<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_balance_background"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- Title -->
    <TextView
        android:id="@+id/widget_balance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balance"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1a1a1a"
        android:fontFamily="serif"
        android:layout_marginBottom="8dp" />

    <!-- Balance Amount -->
    <TextView
        android:id="@+id/widget_balance_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1a1a1a"
        android:layout_marginBottom="12dp" />

    <!-- Amount Input -->
    <EditText
        android:id="@+id/widget_balance_input"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:hint="0.00"
        android:hintTextColor="#9ca3af"
        android:textColor="#1a1a1a"
        android:textSize="14sp"
        android:textStyle="bold"
        android:inputType="numberDecimal|numberSigned"
        android:gravity="center"
        android:background="@drawable/widget_input_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <!-- GANÉ button -->
        <Button
            android:id="@+id/widget_balance_btn_income"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="GANÉ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_btn_income_background"
            android:gravity="center" />

        <!-- GASTÉ button -->
        <Button
            android:id="@+id/widget_balance_btn_expense"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="GASTÉ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_btn_expense_background"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>

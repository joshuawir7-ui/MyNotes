<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_balance_background"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <!-- Title -->
    <TextView
        android:id="@+id/widget_balance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balance"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:fontFamily="serif"
        android:layout_marginBottom="4dp" />

    <!-- Circular Donut Chart Area -->
    <FrameLayout
        android:layout_width="135dp"
        android:layout_height="135dp"
        android:layout_marginBottom="8dp">

        <!-- Donut Chart Canvas Image -->
        <ImageView
            android:id="@+id/widget_balance_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- Center text inside Donut Chart -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALANCE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF" />

            <TextView
                android:id="@+id/widget_balance_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

    <!-- Middle Row: Divider lines + Pill Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <!-- ImageView line instead of View (View is prohibited in RemoteViews) -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E5E7EB" />

        <TextView
            android:id="@+id/widget_balance_input_pill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="0.00 $"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:gravity="center" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E5E7EB" />

    </LinearLayout>

    <!-- Action Buttons Row (AGREGAR / GASTÉ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <TextView
            android:id="@+id/widget_balance_btn_income"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="AGREGAR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_btn_income_background"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_balance_btn_expense"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="GASTÉ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_btn_expense_background"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>

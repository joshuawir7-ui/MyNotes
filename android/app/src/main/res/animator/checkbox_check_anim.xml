<?xml version="1.0" encoding="utf-8"?>
<!--
  Animates the white checkmark stroke drawing itself: trimPathEnd 0 → 1 over 220ms,
  starting after the fill animation begins (startOffset=180ms so check appears once
  the box is mostly green).
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="trimPathEnd"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType"
    android:duration="220"
    android:startOffset="180"
    android:interpolator="@android:interpolator/decelerate_quad" />
